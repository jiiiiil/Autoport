{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "DATABASE_URL": "@database_url",
    "GROQ_API_KEY": "@groq_api_key",
    "JWT_SECRET": "@jwt_secret",
    "APP_URL": "@app_url",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "NODE_ENV": "production"
  }
}
